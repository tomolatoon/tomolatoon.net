---
type SocialLink = {
  readonly label: string;
  readonly href: `https://${string}`;
  readonly icon: `i-${string}`;
};

const socials = [
  { label: 'GitHub', href: 'https://github.com/tomolatoon', icon: 'i-simple-icons-github' },
  { label: 'Twitter', href: 'https://twitter.com/tomolatoon_tw', icon: 'i-simple-icons-x' },
  { label: 'Qiita', href: 'https://qiita.com/tomolatoon', icon: 'i-simple-icons-qiita' },
  { label: 'Zenn', href: 'https://zenn.dev/tomolatoon', icon: 'i-simple-icons-zenn' },
] as const satisfies readonly SocialLink[];
---

<div flex gap="3" items-center>
  {
    socials.map((social) => (
      <a
        href={social.href}
        aria-label={social.label}
        target="_blank"
        rel="noopener noreferrer"
        flex
        items-center
        justify-center
        w="12"
        h="12"
        rounded="full"
        no-underline
        border="[1.5px] [color:var(--cyan-a33)] hover:cyan"
        text="[#555] hover:cyan"
        transition-all
        duration="200"
        bg="hover:[linear-gradient(135deg,var(--cyan-a20),var(--lav-a20))]"
      >
        <span class={`${social.icon} text-[22px]`} />
      </a>
    ))
  }
</div>
