---
// プロトタイプの viewBox="0 0 100 100" SVG をそのまま移植。
// preserveAspectRatio="none" で全画面サイズに伸縮し、幾何図形が常に四隅に収まる。
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class="geo-bg"
  viewBox="0 0 100 100"
  preserveAspectRatio="none"
>
  <defs>
    <linearGradient id="g-cyan-lav" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="var(--cyan)" stop-opacity="0.20" />
      <stop offset="100%" stop-color="var(--lav)" stop-opacity="0.13" />
    </linearGradient>
    <linearGradient id="g-pink-lav" x1="100%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" stop-color="var(--pink)" stop-opacity="0.18" />
      <stop offset="100%" stop-color="var(--lav)" stop-opacity="0.08" />
    </linearGradient>
    <linearGradient id="g-line-c" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="var(--cyan)" stop-opacity="0.7" />
      <stop offset="100%" stop-color="var(--lav)" stop-opacity="0.25" />
    </linearGradient>
    <linearGradient id="g-line-p" x1="100%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="var(--pink)" stop-opacity="0.65" />
      <stop offset="100%" stop-color="var(--lav)" stop-opacity="0.2" />
    </linearGradient>
  </defs>

  <!-- コーナーグラデーション三角形 -->
  <polygon points="100,0 100,42 18,0" fill="url(#g-cyan-lav)" />
  <polygon points="0,100 0,58 82,100" fill="url(#g-pink-lav)" />

  <!-- アウトライン三角形 -->
  <polygon points="6,28 11,16 16,28" fill="none" stroke="var(--cyan)" stroke-width="0.4" stroke-opacity="0.6" vector-effect="non-scaling-stroke" />
  <polygon points="84,84 90,72 96,84" fill="none" stroke="var(--pink)" stroke-width="0.35" stroke-opacity="0.55" vector-effect="non-scaling-stroke" />
  <polygon points="4,58 8,50 12,58" fill="none" stroke="var(--lav)" stroke-width="0.3" stroke-opacity="0.5" vector-effect="non-scaling-stroke" />
  <polygon points="88,18 92,10 96,18" fill="none" stroke="var(--lav)" stroke-width="0.3" stroke-opacity="0.5" vector-effect="non-scaling-stroke" />

  <!-- 対角アクセントライン（シアン） -->
  <line x1="-2" y1="46" x2="22" y2="12" stroke="url(#g-line-c)" stroke-width="0.4" stroke-linecap="round" vector-effect="non-scaling-stroke" />
  <line x1="1" y1="52" x2="20" y2="22" stroke="var(--cyan)" stroke-width="0.18" stroke-opacity="0.3" stroke-linecap="round" vector-effect="non-scaling-stroke" />

  <!-- 対角アクセントライン（ピンク） -->
  <line x1="102" y1="54" x2="78" y2="88" stroke="url(#g-line-p)" stroke-width="0.4" stroke-linecap="round" vector-effect="non-scaling-stroke" />
  <line x1="99" y1="48" x2="80" y2="78" stroke="var(--pink)" stroke-width="0.18" stroke-opacity="0.3" stroke-linecap="round" vector-effect="non-scaling-stroke" />

  <!-- 右上クロスライン -->
  <line x1="68" y1="0" x2="100" y2="20" stroke="var(--lav)" stroke-width="0.3" stroke-opacity="0.45" stroke-linecap="round" vector-effect="non-scaling-stroke" />
  <line x1="78" y1="0" x2="100" y2="14" stroke="var(--cyan)" stroke-width="0.18" stroke-opacity="0.28" stroke-linecap="round" vector-effect="non-scaling-stroke" />

  <!-- 左下クロスライン -->
  <line x1="0" y1="86" x2="18" y2="100" stroke="var(--lav)" stroke-width="0.3" stroke-opacity="0.4" stroke-linecap="round" vector-effect="non-scaling-stroke" />

  <!-- ダイヤモンド -->
  <rect x="47.5" y="5" width="2.2" height="2.2" transform="rotate(45 48.6 6.1)" fill="none" stroke="var(--cyan)" stroke-width="0.3" stroke-opacity="0.55" vector-effect="non-scaling-stroke" />
  <rect x="50" y="92" width="2" height="2" transform="rotate(45 51 93)" fill="none" stroke="var(--pink)" stroke-width="0.28" stroke-opacity="0.5" vector-effect="non-scaling-stroke" />

  <!-- ドットグリッド（右上） -->
  <circle cx="74" cy="20" r="0.55" fill="var(--lav)" fill-opacity="0.45" />
  <circle cx="74" cy="24.5" r="0.55" fill="var(--lav)" fill-opacity="0.45" />
  <circle cx="74" cy="29" r="0.55" fill="var(--lav)" fill-opacity="0.45" />
  <circle cx="78.5" cy="20" r="0.55" fill="var(--lav)" fill-opacity="0.45" />
  <circle cx="78.5" cy="24.5" r="0.55" fill="var(--lav)" fill-opacity="0.45" />
  <circle cx="78.5" cy="29" r="0.55" fill="var(--lav)" fill-opacity="0.45" />
  <circle cx="83" cy="20" r="0.55" fill="var(--lav)" fill-opacity="0.45" />
  <circle cx="83" cy="24.5" r="0.55" fill="var(--lav)" fill-opacity="0.45" />
  <circle cx="83" cy="29" r="0.55" fill="var(--lav)" fill-opacity="0.45" />
  <circle cx="87.5" cy="20" r="0.55" fill="var(--lav)" fill-opacity="0.45" />
  <circle cx="87.5" cy="24.5" r="0.55" fill="var(--lav)" fill-opacity="0.45" />
  <circle cx="87.5" cy="29" r="0.55" fill="var(--lav)" fill-opacity="0.45" />

  <!-- ドットグリッド（左下） -->
  <circle cx="10" cy="72" r="0.5" fill="var(--cyan)" fill-opacity="0.3" />
  <circle cx="10" cy="76.5" r="0.5" fill="var(--cyan)" fill-opacity="0.3" />
  <circle cx="10" cy="81" r="0.5" fill="var(--cyan)" fill-opacity="0.3" />
  <circle cx="14.5" cy="72" r="0.5" fill="var(--cyan)" fill-opacity="0.3" />
  <circle cx="14.5" cy="76.5" r="0.5" fill="var(--cyan)" fill-opacity="0.3" />
  <circle cx="14.5" cy="81" r="0.5" fill="var(--cyan)" fill-opacity="0.3" />
  <circle cx="19" cy="72" r="0.5" fill="var(--cyan)" fill-opacity="0.3" />
  <circle cx="19" cy="76.5" r="0.5" fill="var(--cyan)" fill-opacity="0.3" />
  <circle cx="19" cy="81" r="0.5" fill="var(--cyan)" fill-opacity="0.3" />
</svg>

<style>
  .geo-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
