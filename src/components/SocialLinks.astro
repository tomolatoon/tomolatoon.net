---
const socials = [
  {
    label: "GitHub",
    href: "https://github.com/tomolatoon",
    icon: "i-simple-icons-github",
  },
  {
    label: "Twitter1",
    href: "https://twitter.com/tomolatoon_tw",
    icon: "i-simple-icons-x",
  },
  {
    label: "Qiita",
    href: "https://qiita.com/tomolatoon",
    icon: "i-simple-icons-qiita",
  },
  {
    label: "Zenn",
    href: "https://zenn.dev/tomolatoon",
    icon: "i-simple-icons-zenn",
  },
] as const;
---

<div class="socials">
  {
    socials.map((s) => (
      <a
        href={s.href}
        aria-label={s.label}
        target="_blank"
        rel="noopener noreferrer"
        class="social-btn"
      >
        <span class={`${s.icon} social-btn__icon`} />
      </a>
    ))
  }
</div>

<style>
  .socials {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, var(--cyan) 33%, transparent);
    color: #555;
    text-decoration: none;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .social-btn:hover {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--cyan) 20%, transparent),
      color-mix(in srgb, var(--lav) 20%, transparent)
    );
    border-color: var(--cyan);
    color: var(--cyan);
  }

  .social-btn__icon {
    font-size: 22px;
  }
</style>
