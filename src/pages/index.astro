---
import Base from '@/layouts/Base.astro';
import GeoBg from '@/components/GeoBg.astro';
import Avatar from '@/components/Avatar.astro';
import SocialLinks from '@/components/SocialLinks.astro';

const name    = 'tomolatoon';
const tagline = 'C++ とボカロが好きな一般大学生';
const bio     = 'UEC25, VLL, MMA, 工研, まにけん, squec';
---
<Base>
  <main class="page">
    <GeoBg />

    <div class="card">
      <Avatar shape="circle" />

      <div class="name-block">
        <h1 class="name">{name}</h1>
      </div>

      <div class="bio-block">
        <p class="tagline">{tagline}</p>
        <p class="bio">{bio}</p>
      </div>

      <div class="divider" aria-hidden="true"></div>

      <SocialLinks />
    </div>
  </main>
</Base>

<style>
  .page {
    position: relative;
    width: 100%;
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .card {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(18px, 4vw, 32px);
    padding: clamp(28px, 6vw, 48px) clamp(24px, 8vw, 64px);
    max-width: 480px;
    width: 90%;
    text-align: center;
  }

  .name-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: center;
  }

  .name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(28px, 7vw, 44px);
    letter-spacing: -0.02em;
    color: var(--text-dark);
    line-height: 1.1;
  }

  .handle {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(13px, 3vw, 15px);
    color: var(--cyan);
    letter-spacing: 0.04em;
  }

  .bio-block {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
  }

  .tagline {
    font-family: var(--font-jp);
    font-weight: 500;
    font-size: clamp(13px, 3.2vw, 16px);
    color: var(--text-mid);
    letter-spacing: 0.02em;
  }

  .bio {
    font-family: var(--font-jp);
    font-weight: 300;
    font-size: clamp(12px, 2.8vw, 14px);
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 340px;
  }

  .divider {
    width: 48px;
    height: 2px;
    background: linear-gradient(90deg, var(--cyan), var(--lav));
    border-radius: 2px;
  }
</style>
