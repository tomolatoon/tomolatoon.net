---
interface Props {
  shape?: 'circle' | 'rounded';
}
const { shape = 'circle' } = Astro.props;
const radius = shape === 'circle' ? '50%' : '22%';
---
<div class="avatar" style={`--radius: ${radius}`}>
  <svg viewBox="0 0 80 80" class="avatar__silhouette" aria-hidden="true">
    <circle cx="40" cy="28" r="16" fill="var(--cyan)" fill-opacity="0.5" />
    <ellipse cx="40" cy="68" rx="24" ry="18" fill="var(--lav)" fill-opacity="0.4" />
  </svg>
</div>

<style>
  .avatar {
    width: clamp(80px, 18vw, 120px);
    height: clamp(80px, 18vw, 120px);
    border-radius: var(--radius);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--cyan) 27%, transparent),
      color-mix(in srgb, var(--lav) 27%, transparent)
    );
    border: 3px solid color-mix(in srgb, var(--cyan) 53%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  .avatar__silhouette {
    width: 60%;
    height: 60%;
  }
</style>
