---
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL } from '@/constants/site';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/noto-sans-jp/300.css';
import '@fontsource/noto-sans-jp/500.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  image?: string;
}
const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  canonicalUrl = SITE_URL,
  image = `${SITE_URL}/og-image.svg`,
} = Astro.props;
---

<!doctype html>
<html lang="ja" w="full" h="full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#f8fbff" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body w="full" h="full" font-sans bg="page-bg">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* GeoBg の SVG 属性から参照するため CSS 変数で残す */
    --cyan: #5dd8f0;
    --pink: #d580f5;
    --lav: #8fa8f8;

    /* UnoCSS はクラス経由での値適用のみ対応。SVG 属性・style 属性でカスタムプロパティ名として
       直参照するため、color-mix() 値も含め CSS 変数として事前定義が必要。 */
    --cyan-a20: color-mix(in srgb, #5dd8f0 20%, transparent);
    --cyan-a27: color-mix(in srgb, #5dd8f0 27%, transparent);
    --cyan-a33: color-mix(in srgb, #5dd8f0 33%, transparent);
    --cyan-a53: color-mix(in srgb, #5dd8f0 53%, transparent);
    --lav-a20: color-mix(in srgb, #8fa8f8 20%, transparent);
    --lav-a27: color-mix(in srgb, #8fa8f8 27%, transparent);
  }
</style>
