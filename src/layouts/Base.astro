---
interface Props {
  title?: string;
  description?: string;
}
const { title = 'tomolatoon.net', description = 'C++ とボカロが好きな一般大学生' } = Astro.props;
---

<!doctype html>
<html lang="ja" w="full" h="full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Noto+Sans+JP:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body w="full" h="full" overflow-hidden font-sans bg="page-bg">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* GeoBg の SVG 属性から参照するため CSS 変数で残す */
    --cyan: #5dd8f0;
    --pink: #d580f5;
    --lav: #8fa8f8;

    /* color-mix() は UnoCSS が生成できないため事前定義 */
    --cyan-a20: color-mix(in srgb, #5dd8f0 20%, transparent);
    --cyan-a27: color-mix(in srgb, #5dd8f0 27%, transparent);
    --cyan-a33: color-mix(in srgb, #5dd8f0 33%, transparent);
    --cyan-a53: color-mix(in srgb, #5dd8f0 53%, transparent);
    --lav-a20: color-mix(in srgb, #8fa8f8 20%, transparent);
    --lav-a27: color-mix(in srgb, #8fa8f8 27%, transparent);
  }
</style>
