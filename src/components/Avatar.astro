---
interface Props {
  shape?: 'circle' | 'rounded';
}
const { shape = 'circle' } = Astro.props;
const rounded = shape === 'circle' ? 'full' : '[22%]';
---

<div
  flex
  items-center
  justify-center
  overflow-hidden
  shrink-0
  w="[clamp(80px,18vw,120px)]"
  h="[clamp(80px,18vw,120px)]"
  border="[3px]"
  rounded={rounded}
  style="background: linear-gradient(135deg, var(--cyan-a27), var(--lav-a27)); border-color: var(--cyan-a53);"
>
  <svg viewBox="0 0 80 80" class="w-[60%] h-[60%]" aria-hidden="true">
    <circle cx="40" cy="28" r="16" fill="var(--cyan)" fill-opacity="0.5"></circle>
    <ellipse cx="40" cy="68" rx="24" ry="18" fill="var(--lav)" fill-opacity="0.4"></ellipse>
  </svg>
</div>
