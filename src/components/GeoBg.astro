---
// SVG は preserveAspectRatio="none" で全画面伸縮（三角形・ライン向き）。
// ドットグリッドは CSS 固定配置で幅変化の影響を受けない。
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class="absolute inset-0 w-full h-full pointer-events-none"
  viewBox="0 0 100 100"
  preserveAspectRatio="none"
>
  <defs>
    <linearGradient id="g-cyan-lav" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="var(--cyan)" stop-opacity="0.20"></stop>
      <stop offset="100%" stop-color="var(--lav)" stop-opacity="0.13"></stop>
    </linearGradient>
    <linearGradient id="g-pink-lav" x1="100%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" stop-color="var(--pink)" stop-opacity="0.18"></stop>
      <stop offset="100%" stop-color="var(--lav)" stop-opacity="0.08"></stop>
    </linearGradient>
    <linearGradient id="g-line-c" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="var(--cyan)" stop-opacity="0.7"></stop>
      <stop offset="100%" stop-color="var(--lav)" stop-opacity="0.25"></stop>
    </linearGradient>
    <linearGradient id="g-line-p" x1="100%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="var(--pink)" stop-opacity="0.65"></stop>
      <stop offset="100%" stop-color="var(--lav)" stop-opacity="0.2"></stop>
    </linearGradient>
  </defs>

  <!-- コーナーグラデーション三角形 -->
  <polygon points="100,0 100,42 18,0" fill="url(#g-cyan-lav)"></polygon>
  <polygon points="0,100 0,58 82,100" fill="url(#g-pink-lav)"></polygon>

  <!-- アウトライン三角形 -->
  <polygon
    points="6,28 11,16 16,28"
    fill="none"
    stroke="var(--cyan)"
    stroke-width="0.4"
    stroke-opacity="0.6"
    vector-effect="non-scaling-stroke"></polygon>
  <polygon
    points="84,84 90,72 96,84"
    fill="none"
    stroke="var(--pink)"
    stroke-width="0.35"
    stroke-opacity="0.55"
    vector-effect="non-scaling-stroke"></polygon>
  <polygon
    points="4,58 8,50 12,58"
    fill="none"
    stroke="var(--lav)"
    stroke-width="0.3"
    stroke-opacity="0.5"
    vector-effect="non-scaling-stroke"></polygon>
  <polygon
    points="88,18 92,10 96,18"
    fill="none"
    stroke="var(--lav)"
    stroke-width="0.3"
    stroke-opacity="0.5"
    vector-effect="non-scaling-stroke"></polygon>

  <!-- 対角アクセントライン（シアン） -->
  <line
    x1="-2"
    y1="46"
    x2="22"
    y2="12"
    stroke="url(#g-line-c)"
    stroke-width="0.4"
    stroke-linecap="round"
    vector-effect="non-scaling-stroke"></line>
  <line
    x1="1"
    y1="52"
    x2="20"
    y2="22"
    stroke="var(--cyan)"
    stroke-width="0.18"
    stroke-opacity="0.3"
    stroke-linecap="round"
    vector-effect="non-scaling-stroke"></line>

  <!-- 対角アクセントライン（ピンク） -->
  <line
    x1="102"
    y1="54"
    x2="78"
    y2="88"
    stroke="url(#g-line-p)"
    stroke-width="0.4"
    stroke-linecap="round"
    vector-effect="non-scaling-stroke"></line>
  <line
    x1="99"
    y1="48"
    x2="80"
    y2="78"
    stroke="var(--pink)"
    stroke-width="0.18"
    stroke-opacity="0.3"
    stroke-linecap="round"
    vector-effect="non-scaling-stroke"></line>

  <!-- 右上クロスライン -->
  <line
    x1="68"
    y1="0"
    x2="100"
    y2="20"
    stroke="var(--lav)"
    stroke-width="0.3"
    stroke-opacity="0.45"
    stroke-linecap="round"
    vector-effect="non-scaling-stroke"></line>
  <line
    x1="78"
    y1="0"
    x2="100"
    y2="14"
    stroke="var(--cyan)"
    stroke-width="0.18"
    stroke-opacity="0.28"
    stroke-linecap="round"
    vector-effect="non-scaling-stroke"></line>

  <!-- 左下クロスライン -->
  <line
    x1="0"
    y1="86"
    x2="18"
    y2="100"
    stroke="var(--lav)"
    stroke-width="0.3"
    stroke-opacity="0.4"
    stroke-linecap="round"
    vector-effect="non-scaling-stroke"></line>

  <!-- ダイヤモンド -->
  <rect
    x="47.5"
    y="5"
    width="2.2"
    height="2.2"
    transform="rotate(45 48.6 6.1)"
    fill="none"
    stroke="var(--cyan)"
    stroke-width="0.3"
    stroke-opacity="0.55"
    vector-effect="non-scaling-stroke"></rect>
  <rect
    x="50"
    y="92"
    width="2"
    height="2"
    transform="rotate(45 51 93)"
    fill="none"
    stroke="var(--pink)"
    stroke-width="0.28"
    stroke-opacity="0.5"
    vector-effect="non-scaling-stroke"></rect>
</svg>

<!-- ドットグリッド（右上）: 4 列 × 3 行 = 64×48px、CSS 固定配置 -->
<div
  aria-hidden="true"
  class="absolute pointer-events-none text-lav opacity-45
         bg-[radial-gradient(circle,currentColor_2.5px,transparent_2.5px)]
         [background-size:16px_16px]
         top-[clamp(60px,12vh,120px)] right-[clamp(28px,5vw,64px)]
         w-16 h-12"
>
</div>

<!-- ドットグリッド（左下）: 3 列 × 3 行 = 48×48px、CSS 固定配置 -->
<div
  aria-hidden="true"
  class="absolute pointer-events-none text-cyan opacity-30
         bg-[radial-gradient(circle,currentColor_2.5px,transparent_2.5px)]
         [background-size:16px_16px]
         bottom-[clamp(60px,12vh,120px)] left-[clamp(28px,5vw,64px)]
         w-12 h-12"
>
</div>
