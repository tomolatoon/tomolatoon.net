---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'tomolatoon.net',
  description = 'Web・ツール・音楽など，好きなものをつくっています。',
} = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Noto+Sans+JP:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --cyan:       #5dd8f0;
    --pink:       #d580f5;
    --lav:        #8fa8f8;
    --bg:         #f8fbff;
    --text-dark:  #1a1a2e;
    --text-mid:   #2a2a40;
    --text-muted: #555570;
    --font-sans:  'DM Sans', 'Noto Sans JP', sans-serif;
    --font-jp:    'Noto Sans JP', sans-serif;
  }

  html, body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: var(--font-sans);
    background: var(--bg);
  }
</style>
